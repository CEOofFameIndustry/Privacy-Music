# NewPipe extractor: Rhino runs YouTube's player JS (signature / n-param deobfuscation) via reflection.
-keep class org.mozilla.javascript.** { *; }
-keep class org.mozilla.classfile.ClassFileWriter
-dontwarn org.mozilla.javascript.tools.**
-dontwarn org.mozilla.javascript.engine.**
-dontwarn java.beans.**
-dontwarn javax.script.**
-dontwarn jdk.dynalink.**
# Localized "x minutes ago" patterns are loaded by class name.
-keep class org.schabi.newpipe.extractor.timeago.patterns.** { *; }
# Protobuf-lite messages used for YouTube request parameters.
-keepclassmembers class * extends com.google.protobuf.GeneratedMessageLite { <fields>; }
-dontwarn com.google.re2j.**
-dontwarn org.jspecify.**
