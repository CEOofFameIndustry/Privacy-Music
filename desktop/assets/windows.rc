1 ICON "icon.ico"

// Version info: Windows shows FileDescription as the app's name (media flyout, Task Manager, notifications).
1 VERSIONINFO
FILEVERSION 0,5,4,0
PRODUCTVERSION 0,5,4,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Privacy Music"
      VALUE "FileDescription", "Privacy Music"
      VALUE "FileVersion", "0.5.4"
      VALUE "InternalName", "privacy-music"
      VALUE "OriginalFilename", "privacy-music.exe"
      VALUE "ProductName", "Privacy Music"
      VALUE "ProductVersion", "0.5.4"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
